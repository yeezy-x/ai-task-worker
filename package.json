{
  "name": "ai-task-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-ui",
    "copy-ui": "node -e \"require('fs').cpSync('src/ui', 'dist/ui', { recursive: true })\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "openai": "^7.27.0",
    "playwright": "^1.63.0"
  }
}
